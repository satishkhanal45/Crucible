# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# Async SQLAlchemy URL. Inside docker compose the host is `postgres`; compose
# overrides this value for the api and migrate services.
DATABASE_URL=postgresql+asyncpg://crucible:crucible@localhost:5432/crucible

# Host ports published by docker compose. Change these if they are already taken.
POSTGRES_PORT=5432
API_PORT=8000

# dev | test | prod
ENV=dev
LOG_LEVEL=INFO

# LLM providers. Free tiers; see docs/spec.md section 1 for rules of engagement.
# Two providers, because a free tier's binding limit is a per-model token pool
# and a second host is a second pool. Both are required: a run may put one agent
# on each, and a missing key is a failure at startup rather than mid-run.
# DeepSeek's OpenAI-compatible endpoint (https://api.deepseek.com) was checked
# on 2026-09-04; see https://api-docs.deepseek.com for its current models.
GROQ_API_KEY=replace-me
DEEPSEEK_API_KEY=replace-me
GEMINI_API_KEY=replace-me

# Comma-separated hosts the executor is allowed to reach. Must not be empty.
TARGET_ALLOWLIST=localhost,127.0.0.1

# Per-round spend cap in USD, enforced by CostMeter.
ROUND_BUDGET_USD=5.00

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Model ids. These are the ONLY place model ids are configured: no CLI option
# and no module constant carries one, so editing this file is what changes a
# run. Checked against Groq's catalogue on 2026-09-03 — Groq retires model ids
# on a schedule (llama-3.3-70b-versatile was decommissioned 2026-08-16), so
# check https://console.groq.com/docs/deprecations before a long run.
#
# Provider is chosen PER AGENT, paired with that agent's model: each may be
# `groq` or `deepseek`. This replaced the single LLM_PROVIDER setting when the
# second provider was added — spreading the four agents across two hosts is the
# point of having two, and one global setting could not say that. Setting all
# four to the same value reproduces the old behaviour exactly.
TARGET_PROVIDER=groq
TARGET_MODEL=llama-3.1-8b-instant
ATTACKER_PROVIDER=groq
ATTACKER_MODEL=openai/gpt-oss-120b
DEFENDER_PROVIDER=groq
DEFENDER_MODEL=openai/gpt-oss-120b
CLASSIFIER_PROVIDER=groq
CLASSIFIER_MODEL=openai/gpt-oss-120b

# DeepSeek model ids, for whichever agents you move there. Checked 2026-09-04
# against https://api-docs.deepseek.com/quick_start/pricing:
#   deepseek-chat, deepseek-reasoner

# Tier 3 judge. Not built in this cut (B4); the id is still validated for price.
JUDGE_PROVIDER=gemini
DEFAULT_JUDGE_MODEL=gemini-2.0-flash

# Free-tier pacing for provider calls. The binding limit on Groq's free tier is
# TOKENS per minute (8000 for openai/gpt-oss-120b), not requests: default below
# it, because the estimate that books the window is approximate and the reply
# length is unknown until it arrives. Requests per minute is the secondary cap
# (30 on the free tier). Both are per model. Raise only against a paid tier.
PROVIDER_MAX_CONCURRENCY=1
PROVIDER_MIN_INTERVAL_SECONDS=2.0
PROVIDER_TOKENS_PER_MINUTE=6500
PROVIDER_REQUESTS_PER_MINUTE=25

# Optional per-provider overrides of the pair above, `provider=tokens/requests`
# comma separated. The two hosts do not publish the same limits and never share
# a pool, so a window sized for one must not be applied to the other. Windows
# are keyed by `provider:model`, so groq:X and deepseek:X are always separate.
# PROVIDER_RATE_LIMITS=groq=6500/25,deepseek=100000/60

# Optional. `provider:model=prompt/completion` in USD per 1M tokens, comma
# separated, merged over the dated defaults in src/crucible/config.py. Set this
# when a provider changes its rates: without a price, spend records as NULL and
# ROUND_BUDGET_USD cannot be enforced.
# MODEL_PRICING=groq:openai/gpt-oss-120b=0.15/0.75,groq:llama-3.1-8b-instant=0.05/0.08
